    {
      "id": "RT001",
      "type": "runtime",
      "name": "DSUP State Machine",
      "origin": "v0.7",
      "metadata": {
        "id": "RT001",
        "name": "DSUP State Machine",
        "description": "Defines the lawful state transitions of DSUP runtime geometry, including initialization, update, recovery, halt, and completion cycles.",
        "states": [
          "Initialization",
          "Context Integration",
          "Semantic Update",
          "Legality Check",
          "Recovery Window",
          "Stability Envelope",
          "Completion",
          "Halt"
        ],
        "transitions": [
          {
            "from": "Initialization",
            "to": "Context Integration",
            "condition": "context-window-ready"
          },
          {
            "from": "Context Integration",
            "to": "Semantic Update",
            "condition": "context-legality-valid"
          },
          {
            "from": "Semantic Update",
            "to": "Legality Check",
            "condition": "update-cycle-complete"
          },
          {
            "from": "Legality Check",
            "to": "Recovery Window",
            "condition": "legality-violation-detected"
          },
          {
            "from": "Legality Check",
            "to": "Stability Envelope",
            "condition": "legality-valid"
          },
          {
            "from": "Stability Envelope",
            "to": "Completion",
            "condition": "stability-achieved"
          },
          {
            "from": "Recovery Window",
            "to": "Semantic Update",
            "condition": "recovery-complete"
          },
          {
            "from": "Completion",
            "to": "Halt",
            "condition": "halt-condition-met"
          }
        ]
      }
    },
    {
      "id": "RT002",
      "type": "runtime",
      "name": "DSUP Update Cycle",
      "origin": "v0.7",
      "metadata": {
        "id": "RT002",
        "name": "DSUP Update Cycle",
        "description": "Defines the lawful semantic update process, including curvature propagation, drift correction, and legality preservation.",
        "phases": [
          "Curvature Propagation",
          "Drift Correction",
          "Operator Application",
          "Invariant Preservation",
          "Legality Validation"
        ],
        "operators_used": [
          "Fold Operator",
          "Lift Operator",
          "Invert Operator",
          "Bind Operator",
          "Curvature-Redirect Operator",
          "Legality-Preservation Operator"
        ]
      }
    },
    {
      "id": "RT003",
      "type": "runtime",
      "name": "DSUP Halt Conditions",
      "origin": "v0.7",
      "metadata": {
        "id": "RT003",
        "name": "DSUP Halt Conditions",
        "description": "Defines the lawful conditions under which DSUP runtime geometry halts.",
        "conditions": [
          "legality-plane-failure",
          "invariant-plane-failure",
          "context-window-collapse",
          "identity-boundary-break",
          "simulation-instability",
          "operator-incompatibility"
        ]
      }
    },
    {
      "id": "RT004",
      "type": "runtime",
      "name": "DSUP Recovery Geometry",
      "origin": "v0.7",
      "metadata": {
        "id": "RT004",
        "name": "DSUP Recovery Geometry",
        "description": "Defines the lawful recovery process for restoring drift-coherence, curvature continuity, and legality invariants.",
        "phases": [
          "Recovery Window Activation",
          "Curvature Restoration",
          "Drift-Coherence Rebinding",
          "Invariant Revalidation",
          "Legality Recheck"
        ],
        "operators_used": [
          "Recovery-Window Operator",
          "Bind Operator",
          "Legality-Preservation Operator"
        ]
      }
    },
    {
      "id": "RT005",
      "type": "runtime",
      "name": "Meaning-Condition Coupling",
      "origin": "v0.7",
      "metadata": {
        "id": "RT005",
        "name": "Meaning-Condition Coupling",
        "description": "Defines the lawful coupling between semantic meaning conditions and runtime geometry.",
        "conditions": [
          "semantic-coherence",
          "identity-alignment",
          "context-validity",
          "operator-compatibility",
          "legality-invariant"
        ],
        "coupling_rules": [
          "meaning-condition must preserve legality",
          "meaning-condition must align with identity-boundary",
          "meaning-condition must remain within drift-envelope",
          "meaning-condition must satisfy curvature-flow constraints"
        ]
      }
    },
    {
      "id": "RT006",
      "type": "runtime",
      "name": "Context Window Geometry",
      "origin": "v0.7",
      "metadata": {
        "id": "RT006",
        "name": "Context Window Geometry",
        "description": "Defines the lawful geometry of context windows, including curvature, boundaries, drift envelopes, and stability modes.",
        "fields": [
          "context-curvature",
          "context-boundary",
          "context-drift-envelope",
          "context-stability-mode"
        ],
        "requirements": [
          "context must satisfy legality masks",
          "context must align with identity-boundary",
          "context must remain within manifold stability envelope"
        ]
      }
    },
    {
      "id": "RT007",
      "type": "runtime",
      "name": "Context Legality Masks",
      "origin": "v0.7",
      "metadata": {
        "id": "RT007",
        "name": "Context Legality Masks",
        "description": "Defines legality masks applied to context windows to ensure lawful semantic evolution.",
        "masks": [
          "identity-legality-mask",
          "operator-legality-mask",
          "manifold-legality-mask",
          "runtime-legality-mask"
        ],
        "rules": [
          "mask must preserve legality invariants",
          "mask must align with legality-plane",
          "mask must satisfy invariant-plane constraints"
        ]
      }
    },
    {
      "id": "RT008",
      "type": "runtime",
      "name": "Context Contraction Operators",
      "origin": "v0.7",
      "metadata": {
        "id": "RT008",
        "name": "Context Contraction Operators",
        "description": "Defines operators that contract context windows to restore legality and stability.",
        "operators": [
          "Fold Operator",
          "Invert Operator",
          "Curvature-Redirect Operator"
        ],
        "constraints": [
          "contraction must preserve legality",
          "contraction must maintain identity-boundary",
          "contraction must satisfy curvature-flow invariants"
        ]
      }
    },
    {
      "id": "RT009",
      "type": "runtime",
      "name": "Signal Engine SE01",
      "origin": "v0.7",
      "metadata": {
        "id": "RT009",
        "name": "Signal Engine SE01",
        "description": "Defines the lawful geometry of the DSUP signal engine, including activation, constraints, and legality propagation.",
        "activation": {
          "conditions": [
            "semantic-signal-detected",
            "context-valid",
            "operator-compatible"
          ],
          "phases": [
            "Signal Detection",
            "Signal Amplification",
            "Signal Propagation",
            "Signal Stabilization"
          ]
        },
        "constraints": [
          "signal must preserve legality",
          "signal must remain within drift-envelope",
          "signal must satisfy curvature-flow constraints"
        ]
      }
    },
    {
      "id": "RT010",
      "type": "runtime",
      "name": "Simulation Geometry",
      "origin": "v0.7",
      "metadata": {
        "id": "RT010",
        "name": "Simulation Geometry",
        "description": "Defines the lawful geometry of simulation surfaces, including simulation curvature, boundaries, drift channels, and stability envelopes.",
        "fields": [
          "simulation-curvature",
          "simulation-boundary",
          "simulation-drift-channel",
          "simulation-stability-envelope"
        ],
        "requirements": [
          "simulation must preserve legality",
          "simulation must satisfy invariant-plane",
          "simulation must align with manifold geometry"
        ]
      }
    },
    {
      "id": "LG001",
      "type": "legality",
      "name": "Four-Plane Legality Check",
      "origin": "v0.7",
      "metadata": {
        "id": "LG001",
        "name": "Four-Plane Legality Check",
        "description": "Defines the four legality planes required for lawful semantic evolution: identity, operator, manifold, and runtime legality planes.",
        "planes": [
          {
            "plane": "Identity Legality Plane",
            "conditions": [
              "identity-boundary-coherent",
              "identity-invariant-preserved",
              "identity-curvature-valid"
            ]
          },
          {
            "plane": "Operator Legality Plane",
            "conditions": [
              "operator-compatible",
              "operator-invariant-preserved",
              "operator-curvature-valid"
            ]
          },
          {
            "plane": "Manifold Legality Plane",
            "conditions": [
              "manifold-stability-valid",
              "manifold-boundary-coherent",
              "manifold-curvature-valid"
            ]
          },
          {
            "plane": "Runtime Legality Plane",
            "conditions": [
              "runtime-state-valid",
              "runtime-transition-legal",
              "runtime-invariant-preserved"
            ]
          }
        ],
        "rules": [
          "all four planes must validate for legality to hold",
          "legality failure in any plane triggers recovery window",
          "legality planes must align with invariant validation plane"
        ]
      }
    },
    {
      "id": "LG002",
      "type": "legality",
      "name": "CLCP Plane",
      "origin": "v0.7",
      "metadata": {
        "id": "LG002",
        "name": "CLCP Plane",
        "description": "Defines the Coupled Legality Curvature Plane (CLCP), which governs legality propagation across manifold, runtime, identity, and operator geometry.",
        "fields": [
          "clcp-curvature",
          "clcp-boundary",
          "clcp-drift-envelope",
          "clcp-stability-mode"
        ],
        "conditions": [
          "clcp-curvature must remain within legality bounds",
          "clcp-boundary must align with identity-boundary",
          "clcp-drift-envelope must remain within manifold stability envelope",
          "clcp-stability-mode must satisfy operator legality constraints"
        ],
        "rules": [
          "clcp-plane governs legality propagation",
          "clcp-plane must validate before update-cycle",
          "clcp-plane failure triggers recovery geometry"
        ]
      }
    },
    {
      "id": "LG003",
      "type": "legality",
      "name": "Invariant Validation Plane",
      "origin": "v0.7",
      "metadata": {
        "id": "LG003",
        "name": "Invariant Validation Plane",
        "description": "Defines the invariant validation plane, ensuring that all legality invariants are preserved across semantic evolution.",
        "invariants": [
          "identity-invariant",
          "operator-invariant",
          "manifold-invariant",
          "runtime-invariant",
          "simulation-invariant"
        ],
        "conditions": [
          "invariant must remain within legality bounds",
          "invariant must align with legality-plane",
          "invariant must satisfy curvature-flow constraints"
        ],
        "rules": [
          "invariant-plane must validate before legality-plane",
          "invariant-plane failure triggers recovery-window",
          "invariant-plane governs legality-preservation operator"
        ]
      }
    },
    {
      "id": "LG004",
      "type": "legality",
      "name": "Legality Masks",
      "origin": "v0.7",
      "metadata": {
        "id": "LG004",
        "name": "Legality Masks",
        "description": "Defines legality masks applied across manifold, runtime, identity, operator, and simulation geometry to ensure lawful semantic evolution.",
        "masks": [
          {
            "mask": "Identity Legality Mask",
            "conditions": [
              "identity-boundary-coherent",
              "identity-curvature-valid"
            ]
          },
          {
            "mask": "Operator Legality Mask",
            "conditions": [
              "operator-compatible",
              "operator-curvature-valid"
            ]
          },
          {
            "mask": "Manifold Legality Mask",
            "conditions": [
              "manifold-stability-valid",
              "manifold-boundary-coherent"
            ]
          },
          {
            "mask": "Runtime Legality Mask",
            "conditions": [
              "runtime-state-valid",
              "runtime-transition-legal"
            ]
          },
          {
            "mask": "Simulation Legality Mask",
            "conditions": [
              "simulation-stability-valid",
              "simulation-curvature-valid"
            ]
          }
        ],
        "rules": [
          "legality masks must preserve legality invariants",
          "legality masks must align with legality-plane",
          "legality masks must satisfy invariant-plane constraints"
        ]
      }
    }
