@prefix dlo: <https://www.tnopsi.com/> .
@prefix ex: <https://www.tnopsi.com/> .
@prefix schema: <http://schema.org/> .

ex:navajo-weaving-geometry a dlo:GeometryInstance ;
    schema:name "Navajo Weaving Geometry" ;
    dlo:version "0.7" ;
    dlo:layer "geometry" ;
    dlo:instanceType "natural-invariant-example" ;
    dlo:description "Geometric weaving system defined by warp tension, weft insertion, recursive motifs, and color-sequence encoding within Navajo textile practice." ;
    dlo:invariantProperties (
        "warp tension coherence"
        "recursive motif stability"
        "color-sequence proportionality"
        "boundary-anchored geometry"
    ) ;
    dlo:geometryType "warp/weft orthogonal and recursive motif geometry" ;
    dlo:signalType "tactile tension, visual color, and cultural pattern signals" ;
    dlo:dsloOperators (
        "BO-1 boundary formation"
        "MGO-2 recursive growth"
        "SGO-7 categorical encoding"
    ) ;
    dlo:dsloInvariants (
        "warp tension coherence"
        "recursive motif stability"
        "color-sequence proportionality"
    ) ;
    dlo:dsloManifolds (
        "warp manifold"
        "weft manifold"
        "motif manifold"
    ) ;
    dlo:dsloDynamics (
        "regional stylistic drift"
        "tension collapse"
        "pattern restoration"
    ) ;
    dlo:crossDomainPresence "Andean weaving, kente cloth, geometric tiling, grid-based rendering" ;
    dlo:source "DSLO Natural Geometry Registry" .

