@prefix dlo: <https://www.tnopsi.com/> .
@prefix ex: <https://www.tnopsi.com/> .
@prefix schema: <http://schema.org/> .

ex:cuttlefish-patterning a dlo:GeometryInstance ;
    schema:name "Cuttlefish Patterning" ;
    dlo:version "0.7" ;
    dlo:layer "geometry" ;
    dlo:instanceType "natural-invariant-example" ;
    dlo:description "Modular adaptive geometry formed through reaction–diffusion pattern modes, gradient sensing, and texture-aligned curvature." ;
    dlo:invariantProperties (
        "modular-pattern coherence"
        "reaction-diffusion stability"
        "texture-aligned curvature"
        "distributed pattern synthesis"
    ) ;
    dlo:geometryType "modular reaction–diffusion and texture-adaptive morphological geometry" ;
    dlo:signalType "light-gradient, substrate-texture, boundary-shape, and chromatophore-cluster signals" ;
    dlo:dsloOperators (
        "SGO-1 gradient"
        "SGO-4 reaction-diffusion"
        "MGO-5 adaptive morphology"
    ) ;
    dlo:dsloInvariants (
        "modular-pattern coherence"
        "reaction-diffusion stability"
        "texture-aligned curvature"
    ) ;
    dlo:dsloManifolds (
        "pattern-bank manifold"
        "reaction-diffusion manifold"
        "texture-alignment manifold"
    ) ;
    dlo:dsloDynamics (
        "environmental drift"
        "signal-collapse"
        "pattern-switch restoration"
    ) ;
    dlo:crossDomainPresence "cephalopod camouflage, orchid mantis mimicry, adaptive machine textures, procedural pattern libraries" ;
    dlo:source "DSLO Natural Geometry Registry" .

